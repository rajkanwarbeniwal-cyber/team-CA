# Supabase Configuration
# Get these from your Supabase project settings (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI API Key
# Required for AI question generation feature
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Encryption Key for API Keys
# Must be exactly 32 bytes (64 hex characters) for AES-256-GCM
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-character-hex-string-here

# Optional: AI Gateway API Key
# Only required if using providers other than OpenAI/Claude/Google that need it
# AI_GATEWAY_API_KEY=your-key-here

# Optional: Vercel Blob Storage
# For file uploads (avatars, documents)
# BLOB_READ_WRITE_TOKEN=your-token-here
